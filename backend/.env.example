PORT=3001
ALLOWED_ORIGIN=https://www.example.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=study_house_library
DB_USER=study_house_app
DB_PASSWORD=replace-me
INTERNAL_API_TOKEN=replace-with-a-long-random-token
PRIVATE_EXPORT_DIR=/var/lib/study-house-library/private-exports
PRIVATE_BACKUP_DIR=/var/lib/study-house-library/private-backups
BACKUP_RETENTION_DAYS=30
MYSQL_BACKUP_DEFAULTS_FILE=/etc/study-house-library/mysql-backup.cnf
